{
  "name": "@haneoka/vega-plugin-spine",
  "version": "0.1.0",
  "description": "Code-only Spine model provider plugin for Vega",
  "keywords": [
    "visual-novel",
    "spine",
    "skeletal-animation",
    "vega"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega-plugin-spine.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega-plugin-spine#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega-plugin-spine/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "peerDependencies": {
    "@haneoka/vega": "^0.1.0"
  },
  "devDependencies": {
    "@haneoka/vega": "^0.1.0",
    "typescript": "^6.0.3",
    "prettier": "3.7.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.14.0",
  "vega": {
    "pluginApi": 1,
    "kind": "character",
    "capabilities": [
      "character"
    ],
    "permissions": [
      "render:webgl"
    ],
    "externalRuntime": true,
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
